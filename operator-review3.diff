+    std::fs::create_dir_all(&out_dir).unwrap();
+
+    let host = CommandHost::new(store.as_ref(), &client, guard.as_ref(), Some(&browser));
+    let result = StdPocRunner::with_output_dir(out_dir.clone())
+        .run(&poc, example1_bindings(vuln), &host)
+        .await
+        .expect("run");
