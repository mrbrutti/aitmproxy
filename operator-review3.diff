+
+    // poc.artifact, confined to the same out-dir, reads the YAML copy back.
+    let cfg = Config {
+        poc: PocConfig {
+            dir: None,
+            out_dir: Some(out_dir.clone()),
+        },
+        ..Config::default()
+    };
