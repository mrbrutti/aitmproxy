+        .with_config(Arc::new(cfg.clone()))
+        .with_services(store, client, proxy.guard(), None);
+    let value = cli
+        .dispatch(&["config".to_string(), "get".to_string()])
+        .expect("cli config.get");
+    let text = format!("{value:?}");
+    assert!(
