{
  "name": "aitm-web",
  "private": true,
  "version": "0.1.0",
  "description": "aitmproxy web operator UI (SolidJS + TypeScript), served by `aitm web`",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@codemirror/merge": "^6.10.0",
    "@lezer/highlight": "^1.2.0",
    "@tanstack/solid-virtual": "^3.13.0",
    "lucide-solid": "^0.544.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.0"
  }
}
