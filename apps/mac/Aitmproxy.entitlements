<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Host-app entitlements for the Network/System Extension capture path.
  Developer ID distribution values (the Task-1 spike proved these activate on
  macOS 27). Do NOT reuse EmbeddedObscura.entitlements (that is obscura-only JIT).
  These are restricted entitlements: they are authorised by the embedded
  Developer ID provisioning profile "Aitmproxy Host DeveloperID" (App ID
  995PCLM9KH.com.mrbrutti.aitmproxy), minted in A1.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>app-proxy-provider-systemextension</string>
    </array>
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>995PCLM9KH.com.mrbrutti.aitmproxy</string>
    <key>com.apple.developer.team-identifier</key>
    <string>995PCLM9KH</string>
</dict>
</plist>
